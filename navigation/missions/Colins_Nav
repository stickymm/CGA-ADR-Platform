@dataclass
class VehicleState:
    """Latest MAVLink-derived local pose snapshot for the drone."""
    n: float = 0.0
    e: float = 0.0
    d: float = 0.0
    yaw_rad: float = 0.0
    have_local_position: bool = False
    have_attitude: bool = False


@dataclass
class GateDetection:
    """One gate observation coming from the vision pipeline over UDP."""
    timestamp: float
    dist: float
    forward: float
    right: float
    down: float
    roll: float
    pitch: float
    yaw_deg: float


@dataclass
class LocalTarget:
    """Position and yaw target expressed in local NED coordinates."""
    n: float
    e: float
    d: float
    yaw_rad: float

@dataclass
